# Copy to .env.local and fill in. Never commit the real file.

# --- Required ---

# MongoDB connection string and database name
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ipomilega

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Site origin, used by server-side fetches to this app's own API
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get admin rights. They must sign in with a verified email (Google works).
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# --- Optional ---

# Image uploads (IPO logos, blog covers). Also add the bucket host to images.remotePatterns in next.config.ts.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI parser for pasted prospectus text (any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared secret the background jobs send to /api/revalidate after writing to Mongo
REVALIDATE_SECRET=

# Background services shown on the admin status panel
SCRAPER_SERVICE_URL=
LIVE_SERVICE_URL=
LIVE_SERVICE_TOKEN=
ANALYSIS_SERVICE_URL=

# Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=
