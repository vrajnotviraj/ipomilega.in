# Copy to .env.local and fill in. Never commit the real file.

# --- Required ---

# MongoDB connection string and database name. Use a read-only user where possible:
# the site only writes to the subscribers collection (IPO alert signups), and creates its indexes on first use.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ipo-milega

# Shared secret the engine sends to /api/revalidate after writing to Mongo. Generate with: openssl rand -base64 32
REVALIDATE_SECRET=

# --- Optional ---

# PostHog project token (events go through the /ingest proxy in next.config.ts)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# --- IPO alert emails (welcome mail on signup) ---
# Any SMTP server. For Amazon SES in Mumbai: host email-smtp.ap-south-1.amazonaws.com, port 587, and SES SMTP
# credentials (made in the SES console; they are not the IAM access keys). Unset SMTP_HOST and signups are still
# saved, but no mail is sent: the server logs a line instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From and Reply-To headers. The From domain needs SPF and DKIM set up with the SMTP provider.
EMAIL_FROM="IPO Milega <hello@ipomilega.in>"
EMAIL_REPLY_TO=
